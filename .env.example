# ==============================================================================
# PLAYLISTVAULT — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' or set these variables in your deployment host
# (e.g., Vercel, Netlify, Cloudflare Pages).
#
# IMPORTANT SECURITY RULES:
# 1. This application runs entirely in the user's browser.
# 2. NEVER add Supabase Service Role keys or database passwords to frontend variables.
# 3. NEVER add Spotify Client Secret to frontend variables (PKCE OAuth is secretless).
# 4. Only variables prefixed with VITE_ are exposed to the browser client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Expected values: 'development' | 'staging' | 'production'
VITE_APP_ENV=production

# (Optional) Canonical Base URL of the deployed application
# Example: https://playlistvault.app
VITE_APP_BASE_URL=https://playlistvault.app

# ------------------------------------------------------------------------------
# 2. SUPABASE CONFIGURATION (Private PostgreSQL & Optional Cloud Storage)
# ------------------------------------------------------------------------------
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
# - VITE_SUPABASE_URL: Your unique project HTTPS URL
# - VITE_SUPABASE_ANON_KEY: Safe publishable client key (governed by Row Level Security)
#
# Note: If omitted or set to placeholders, PlaylistVault automatically falls back
# to resilient offline-first mode using browser IndexedDB and LocalStorage.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# ------------------------------------------------------------------------------
# 3. SPOTIFY DEVELOPER API CONFIGURATION (PKCE OAuth 2.0 Flow)
# ------------------------------------------------------------------------------
# Retrieve from: Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
# - Create an application.
# - Copy the Client ID.
# - In "Redirect URIs", add your deployment callback URL(s), for example:
#     - http://localhost:5173/callback (for local dev)
#     - https://playlistvault.app/callback (for production)
# - Note: NO CLIENT SECRET IS NEEDED. PlaylistVault uses RFC 7636 Authorization Code with PKCE.
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id

# (Optional) Explicit redirect URI override. If left blank, PlaylistVault
# dynamically detects window.location.origin + '/callback'.
# Example: https://playlistvault.app/callback
VITE_SPOTIFY_REDIRECT_URI=
